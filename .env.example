# Certificate Tracker configuration. Copy to .env and edit ON THE NAS.
# Never commit .env or paste its secrets anywhere.

# ---------------------------------------------------------------- app
# Port the app listens on inside the container (plain HTTP).
PORT=8080
# Port on the NAS that maps to the app. Tailscale Funnel :8443 points here.
APP_HOST_PORT=8085
# Container timezone; also the default reminder timezone (changeable in Settings).
TZ=Europe/Bucharest
# Long random secret for signing notification-button tokens and flash messages.
# Generate with:  openssl rand -base64 48
SECRET_KEY=change-me-to-a-long-random-value
# true when the app runs behind a reverse proxy (Tailscale Funnel): use X-Forwarded-For /
# X-Forwarded-Proto for client IPs (rate limiting) and HTTPS detection.
TRUST_PROXY=true
# Public HTTPS address of the app (Funnel URL, port 8443). Used for links in notifications.
# Cookies are marked Secure automatically when this starts with https://
PUBLIC_BASE_URL=https://your-nas.your-tailnet.ts.net:8443
# Optional: create the first admin on startup instead of using the setup screen.
# Remove both lines after the first start.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=
# Optional: minimum password length (default 10).
#MIN_PASSWORD_LENGTH=10
# Optional: user/group id the containers run as (must own ./data and ./ntfy/data). Check with `id`.
PUID=1000
PGID=1000

# ---------------------------------------------------------------- notifications
# ntfy (default when NTFY_URL and NTFY_TOPIC are set) or console (log only, for development).
#NOTIFIER=ntfy
# Internal address of the ntfy container on the Docker network.
NTFY_URL=http://ntfy:2586
# Public ntfy address phones subscribe to (Funnel URL, port 10000).
NTFY_PUBLIC_URL=https://your-nas.your-tailnet.ts.net:10000
# Port on the NAS that maps to ntfy. Tailscale Funnel :10000 points here.
NTFY_HOST_PORT=8095
# Prefix of the personal topics: each user gets <prefix>-<username>. Pick something not guessable,
# e.g. certs-<random> (openssl rand -hex 4).
NTFY_TOPIC=certs-change-me
# Write-only access token of the ntfy "publisher" user (starts with tk_). See README.
NTFY_TOKEN=
